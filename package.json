{
  "name": "gold-khata-book",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "check:store": "node scripts/store-guard/bin/store-guard.js check",
    "check:store:ios": "node scripts/store-guard/bin/store-guard.js check --ios",
    "check:store:android": "node scripts/store-guard/bin/store-guard.js check --android",
    "attest:store": "node scripts/store-guard/bin/store-guard.js attest",
    "attest:store:ios": "node scripts/store-guard/bin/store-guard.js attest --ios",
    "attest:store:android": "node scripts/store-guard/bin/store-guard.js attest --android",
    "attestations": "node scripts/store-guard/bin/store-guard.js attestations",
    "release-notes": "node scripts/release-notes/bin/release-notes.js",
    "release-notes:play": "node scripts/release-notes/bin/release-notes.js --play --generate",
    "release-notes:ios": "node scripts/release-notes/bin/release-notes.js --ios --generate",
    "dev": "cross-env WEBPACK=true APP_ENV=dev webpack serve --mode development --config webpack.config.js",
    "build": "cross-env WEBPACK=true APP_ENV=prod webpack --mode production --config webpack.config.js",
    "deploy": "npm run build && npx firebase deploy --only hosting --project PLACEHOLDER-firebase-project --non-interactive"
  },
  "dependencies": {
