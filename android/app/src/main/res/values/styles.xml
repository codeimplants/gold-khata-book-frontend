<resources>

    <!-- Base application theme. -->
    <!-- On Android 15+ (targetSdk >= 35) edge-to-edge is enforced by the OS and
         windowDrawsSystemBarBackgrounds / navigationBarColor / statusBarColor are
         ignored. System bar backgrounds are handled by react-native-edge-to-edge
         (edgeToEdgeEnabled=true) and the RN StatusBar component at runtime. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Dark nav-bar icons so they stay visible over the white tab bar. -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

</resources>
