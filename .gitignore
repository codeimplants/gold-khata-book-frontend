# Claude Code local config
.claude/

# Generated JS bundle. React Native's Gradle plugin bundles into
# android/app/build/generated/assets/react/<variant>/, so a copy under src/main/assets/
# is never needed. One was committed here in 2026 and Gradle's mergeReleaseAssets kept
# preferring it over the freshly generated bundle, so every release APK/AAB shipped
# months-old JavaScript while the native side stayed current. Keep this ignored, and
# see scripts/lib/js-bundle.ps1 — the build scripts hard-fail if it ever reappears.
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.map

# Local APK build timing log
build-times.log

# Screenshots captured from a connected device for visual debugging.
# The pattern matches at any depth, so the store listing assets under
# store-assets/ — which ARE meant to be committed — need re-including.
screenshots/
!store-assets/screenshots/

# Web build output (webpack -> Firebase Hosting)
dist/

# Firebase
.firebase/
.firebase-key.json
*-service-account*.json
*-adminsdk-*.json
serviceAccount*.json

# Backend repo cloned here for local reference (separate git repo)
gold-khata-book-backend/

# Local iOS release config (identifiers, not secrets)
scripts/release-ios.config.sh

# Nexus API key — a real credential, must not be committed. See
# src/config/secrets.example.ts for setup.
src/config/secrets.ts

# Expo's per-machine scratch dir. Holds devices.json (which of YOUR devices
# recently opened the project) and settings.json (your local dev-server config)
# — nothing another developer can use. Expo's own README in there says not to
# share it; it just never reached this file because the folder only appears
# once someone runs the Expo-backed dev server.
.expo/
